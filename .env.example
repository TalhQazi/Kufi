# Optional: copy to .env.local to override defaults.

# Live view / production (default): do NOT set VITE_API_URL.
# The app uses https://kufi-backend-new1.vercel.app/api for live view and deployed builds.

# Local backend (same IDE):
VITE_API_URL=http://localhost:5000/api

# Public website origin. Used at build time by scripts/generate-sitemap.mjs to write
# dist/sitemap.xml and to set the Sitemap: line in dist/robots.txt.
# Must be the SITE origin, not the API host.
VITE_SITE_URL=https://kufitravel.com

VITE_GOOGLE_CLIENT_ID=
